<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for the Go services (replaces nginx). Requires URL Rewrite + ARR
  with the ARR proxy enabled, and the one-time server settings in setup.ps1.

    /v1/in/*   -> ingest  http://127.0.0.1:8081/v1/in/*
    /healthz   -> ingest  http://127.0.0.1:8081/healthz
    /api/*     -> api     http://127.0.0.1:8080/*        (prefix stripped)
    anything else -> dashboard static files in this folder (web/dist), SPA fallback to index.html
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Webhook ingest. X-Real-IP is overwritten with the real client address,
             so a client-sent X-Real-IP never reaches the Go service. -->
        <rule name="ingest" stopProcessing="true">
          <match url="^v1/in/(.+)$" />
          <serverVariables>
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <!-- The public host the sender used: URL-signed providers (Twilio, HubSpot, Square)
                 sign it, and ARR doesn't pass the original Host header on. -->
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8081/v1/in/{R:1}" />
        </rule>

        <rule name="healthz" stopProcessing="true">
          <match url="^healthz$" />
          <action type="Rewrite" url="http://127.0.0.1:8081/healthz" />
        </rule>

        <rule name="api" stopProcessing="true">
          <match url="^api/(.*)$" />
          <serverVariables>
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>

        <!--API-HOST The API's own domain (INGEST_BASE_URL) serves the API without the /api
             prefix: https://__API_HOST__/v1/... setup.ps1 removes this rule when that domain
             is the IIS host itself. -->
        <rule name="api-host" stopProcessing="true">
          <match url="^(v1/.*|readyz)$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^__API_HOST_RE__$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>
        <!--/API-HOST-->

        <!-- www.<host> -> <host>, for page loads only. -->
        <rule name="strip-www" stopProcessing="true">
          <match url="(.*)" />
          <!-- The host must be the last condition: {C:1} refers to the last one matched. -->
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            <add input="{URL}" pattern="^/\.well-known/" negate="true" />
            <add input="{HTTP_HOST}" pattern="^www\.(.+)$" />
          </conditions>
          <action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Permanent" />
        </rule>

        <!--DASHBOARD-MOVED The dashboard lives at __DASHBOARD_HOST__: its pages on the other hosts
             (the IIS host, the API domain) redirect there. Ingest, the API, health and Grafana
             stay, since webhook senders and SDKs are configured with those hosts. setup.ps1
             removes this rule when DASHBOARD_URL is on the IIS host. -->
        <rule name="dashboard-moved" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^__HOST_RE__$" />
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            <add input="{URL}" pattern="^/(\.well-known/|grafana(/|$))" negate="true" />
          </conditions>
          <action type="Redirect" url="https://__DASHBOARD_HOST__/{R:1}" redirectType="Permanent" />
        </rule>
        <!--/DASHBOARD-MOVED-->

        <!-- Dashboard over plain HTTP -> HTTPS. Only for page loads (GET), never for
             ingest (webhook senders drop the POST body on a redirect) and never for
             certificate renewal (/.well-known). -->
        <rule name="dashboard-https" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" />
            <add input="{REQUEST_METHOD}" pattern="^GET$" />
            <add input="{URL}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Grafana (monitoring, install with deploy\monitoring\install.ps1): HTTPS only, behind Grafana's
             own login. It is configured to live under /grafana/, so the path is passed through as is. -->
        <rule name="grafana" stopProcessing="true">
          <match url="^grafana(/.*)?$" />
          <conditions>
            <add input="{HTTPS}" pattern="on" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/grafana{R:1}" />
        </rule>

        <!-- Dashboard (single-page app): any path that isn't a real file loads index.html. -->
        <rule name="dashboard-spa" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{URL}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Hide IIS/ARR version headers. -->
        <rule name="hide-server">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Match MAX_BODY_BYTES (5 MiB); IIS rejects larger bodies with 413 before proxying. -->
        <requestLimits maxAllowedContentLength="5242880" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- HTTPS only for a year, for this host alone (no includeSubDomains: other sites share the domain). -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <!-- The dashboard loads nothing from other origins. style-src allows inline style attributes
             (charts, progress bars); scripts are same-origin files only. wss://__HOST__ is filled in by setup.ps1 with every public
             host (ingest and the dashboard). -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://__HOST__; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
      </customHeaders>
    </httpProtocol>

    <!-- gzip the dashboard's JS/CSS/SVG (setup.ps1 also sets frequentHitThreshold=1 so the
         first request is compressed too). API/ingest responses are small and not compressed.
         WebSockets (/api/v1/orgs/{org}/stream) pass through ARR via the "api" rule. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!-- index.html must always be revalidated so a new deploy shows up immediately. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <!-- Go returns its own JSON errors; don't replace them with IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- Vite puts a content hash in every asset filename, so these can be cached for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Grafana sends its own Content-Security-Policy (with a per-page nonce); the dashboard's
       stricter one would block its scripts. -->
  <location path="grafana">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
