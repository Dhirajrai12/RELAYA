      "title": "Events received (per 5 minutes)",
      "description": "Webhook events arriving at the ingest endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "relaya-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
