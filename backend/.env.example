# Copy to .env. Never commit .env.
APP_ENV=dev
DATABASE_URL=postgres://relaya:relaya@postgres:5432/relaya?sslmode=disable

# Base64 of 32 random bytes. Generate: openssl rand -base64 32
# Losing this key makes every stored secret unreadable. Use a different key per environment.
MASTER_KEY=
MASTER_KEY_ID=local-1

API_ADDR=:8080
INGEST_ADDR=:8081
# Public base URL of the ingest endpoint, e.g. https://in.example.com (IIS site host).
INGEST_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Keep equal to maxAllowedContentLength in deploy/iis/web.config.
MAX_BODY_BYTES=5242880
SESSION_TTL=720h
# true behind IIS/ARR (IIS sets X-Real-IP); false when clients reach the Go services directly.
TRUST_PROXY_HEADERS=false

# Outbound delivery (worker). In production keep both false: destinations must be public https URLs.
# APP_ENV=dev turns both on so you can deliver to http://localhost receivers.
DELIVERY_ALLOW_HTTP=false
DELIVERY_ALLOW_PRIVATE=false
WORKER_CONCURRENCY=8

# Integration contracts: propose a contract after this many events of a type,
# or after the window with at least 3.
CONTRACT_MIN_SAMPLES=20
CONTRACT_LEARN_WINDOW=24h
# Incidents close themselves after this long with no new occurrences, once a
# later event of that type matched the contract. 0 disables.
INCIDENT_AUTO_RESOLVE_AFTER=1h

# Alerts. Links in alerts point here (the dashboard's public URL); defaults to INGEST_BASE_URL.
DASHBOARD_URL=http://localhost:5173
# Email alerts need an SMTP server. Leave SMTP_HOST empty to disable the email channel.
# Port 465 uses implicit TLS; other ports use STARTTLS when the server offers it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Relaya Alerts <alerts@example.com>

# Connections: the OAuth redirect URI orgs register in their Zoho/HubSpot/Google apps.
# Defaults to DASHBOARD_URL + /api/v1/connect/callback (IIS sends /api to the API service).
# CONNECT_REDIRECT_URI=

# Rate limits (0 turns one off). Sign-in (20/min per IP, 10 failures per 15 min per
# account) and sign-up (10/hour per IP) limits are fixed.
RATE_LIMIT_INGEST_PER_SECOND=100
RATE_LIMIT_INGEST_BURST=1000
RATE_LIMIT_API_PER_MINUTE=600

# Retention: event payloads (with deliveries and contract findings), and the alert log.
EVENT_RETENTION=720h
ALERT_RETENTION=2160h

# Bearer token for GET /metrics (Prometheus). Empty = metrics off.
METRICS_TOKEN=
